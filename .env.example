# ──────────────────────────────────────────────────────────────
# Variables de entorno — Surtimueve más
# ──────────────────────────────────────────────────────────────
# 1. Copia este archivo como .env.local para desarrollo local:
#       cp .env.example .env.local
#
# 2. En Vercel: Settings → Environment Variables → agregar las
#    dos variables de abajo con los valores reales de Supabase.
#
# Cómo obtener los valores:
#   → Supabase Dashboard → tu proyecto → Settings → API
#   → "Project URL"   = VITE_SUPABASE_URL
#   → "anon public"   = VITE_SUPABASE_ANON_KEY
# ──────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
